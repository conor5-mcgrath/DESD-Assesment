{"executionPlatform":"Camunda Cloud","executionPlatformVersion":"8.6.0","exporter":{"name":"Camunda Web Modeler","version":"64767e4"},"schemaVersion":11,"id":"confirm-details-form","components":[{"text":"# Review your order\n\nOrder reference: {{orderId}}\n\n**Items**\n\n{{ string join(for i in basket return \"- \" + i.productName + \" x\" + string(i.quantity) + \" (\" + string(i.unitPrice * i.quantity) + \")\", \"\\n\") }}\n\n**Amount per producer**\n\n{{ string join(for p in commissionSummary.producerPayouts return \"- Producer \" + p.producerId + \": \" + string(p.grossAmount), \"\\n\") }}\n\n**Order total: {{currency}} {{commissionSummary.orderTotal}}**","type":"text","layout":{"row":"Row_1","columns":null},"id":"Field_review"},{"text":"**Your last payment attempt was not successful** ({{retryReason}}). Please check your card details and try again. Attempt {{paymentAttempts}} of 3.","type":"text","layout":{"row":"Row_2","columns":null},"id":"Field_retry","conditional":{"hide":"=retryReason = null"}},{"label":"Delivery or collection","type":"radio","layout":{"row":"Row_3","columns":null},"id":"Field_fulfilment","key":"fulfilmentChoice","defaultValue":"collection","values":[{"label":"Collection","value":"collection"},{"label":"Delivery","value":"delivery"}],"validate":{"required":true}},{"label":"Delivery address","type":"textfield","layout":{"row":"Row_4","columns":null},"id":"Field_address","key":"deliveryAddress","conditional":{"hide":"=fulfilmentChoice != \"delivery\""},"validate":{"required":true}},{"label":"Confirm or cancel this order","type":"radio","layout":{"row":"Row_5","columns":null},"id":"Field_decision","key":"decision","values":[{"label":"Confirm and pay","value":"confirm"},{"label":"Cancel order","value":"cancel"}],"validate":{"required":true}},{"text":"## Payment details\n\nYour card details are sent directly to the external payment service to take this payment. They are not stored by the marketplace.","type":"text","layout":{"row":"Row_6","columns":null},"id":"Field_paytext","conditional":{"hide":"=decision != \"confirm\""}},{"label":"Name on card","type":"textfield","layout":{"row":"Row_7","columns":null},"id":"Field_cardholder","key":"cardholderName","conditional":{"hide":"=decision != \"confirm\""},"validate":{"required":true}},{"label":"Card number","description":"16 digits, no spaces","type":"textfield","layout":{"row":"Row_8","columns":null},"id":"Field_cardnumber","key":"cardNumber","conditional":{"hide":"=decision != \"confirm\""},"validate":{"required":true,"pattern":"^[0-9]{16}$"}},{"label":"Expiry date (MM/YY)","type":"textfield","layout":{"row":"Row_9","columns":8},"id":"Field_expiry","key":"cardExpiry","conditional":{"hide":"=decision != \"confirm\""},"validate":{"required":true,"pattern":"^(0[1-9]|1[0-2])/[0-9]{2}$"}},{"label":"Security code (CVV)","type":"textfield","layout":{"row":"Row_9","columns":8},"id":"Field_cvv","key":"cardCvv","conditional":{"hide":"=decision != \"confirm\""},"validate":{"required":true,"pattern":"^[0-9]{3,4}$"}},{"label":"Submit","type":"button","layout":{"row":"Row_10","columns":null},"id":"Field_submit","action":"submit"}],"type":"default"}