        <bpmn:flowNodeRef>Activity_1qvr40h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1ovmynn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StoreOK</bpmn:flowNodeRef>
