    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:dataStore id="DataStore_Orders" name="orders (SQL database)" />
  <bpmn:collaboration id="Collaboration_0byg98s" name="Order management">
    <bpmn:participant id="Participant_0u9dj7b" name="Digital marketplace" processRef="Process_MarketplaceCheckout" />
    <bpmn:participant id="Participant_0x7plfr" name="External Payment System" processRef="Process_0t5wapm" />
    <bpmn:messageFlow id="Flow_009rdxy" name="Payment result" sourceRef="EndEvent_PaymentResponse" targetRef="Event_1fr5wwa" />
    <bpmn:messageFlow id="Flow_0nd93ls" sourceRef="Event_10lfm8s" targetRef="StartEvent_PaymentRequest" />
  </bpmn:collaboration>
  <bpmn:process id="Process_MarketplaceCheckout" name="E-commerce Checkout Process" processType="None" isClosed="false" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1xrff5d">
      <bpmn:lane id="Lane_1popzac" name="Customer">
        <bpmn:flowNodeRef>adjust_quantity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_basket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0l4t4de</bpmn:flowNodeRef>
