{"executionPlatform":"Camunda Cloud","executionPlatformVersion":"8.6.0","exporter":{"name":"Camunda Web Modeler","version":"64767e4"},"schemaVersion":11,"id":"order-summary-form","components":[{"text":"# Thank you - your order is confirmed\n\nOrder reference: **{{orderId}}**\n\nPayment transaction: **{{transactionId}}**\n\nOrder total: **{{currency}} {{orderTotal}}**\n\nFulfilment: **{{fulfilmentChoice}}**\n\n**Items**\n\n{{ string join(for i in basket return \"- \" + i.productName + \" x\" + string(i.quantity) + \" (\" + string(i.unitPrice * i.quantity) + \")\", \"\\n\") }}","type":"text","layout":{"row":"Row_1","columns":null},"id":"Field_summary"},{"label":"Done","type":"button","layout":{"row":"Row_2","columns":null},"id":"Field_done","action":"submit"}],"type":"default"}