        <dc:Bounds x="285" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cust_SendOrder_di" bpmnElement="Cust_SendOrder" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="362" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
