        <dc:Bounds x="450" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cust_MergeChoose_di" bpmnElement="Cust_MergeChoose" isMarkerVisible="true">
        <dc:Bounds x="575" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cust_Choose_di" bpmnElement="Cust_Choose">
        <dc:Bounds x="650" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cust_SendPref_di" bpmnElement="Cust_SendPref">
        <dc:Bounds x="1002" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="989" y="258" width="63" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cust_CatchAvail_di" bpmnElement="Cust_CatchAvail">
        <dc:Bounds x="1712" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cust_Review_di" bpmnElement="Cust_Review">
        <dc:Bounds x="1820" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cust_GwAccept_di" bpmnElement="Cust_GwAccept" isMarkerVisible="true">
        <dc:Bounds x="1965" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cust_Confirm_di" bpmnElement="Cust_Confirm">
        <dc:Bounds x="2080" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cust_CatchFinal_di" bpmnElement="Cust_CatchFinal">
        <dc:Bounds x="2252" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cust_ViewFinal_di" bpmnElement="Cust_ViewFinal">
        <dc:Bounds x="2360" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cust_End_di" bpmnElement="Cust_End" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="2522" y="222" width="36" height="36" />
